# Copy to .env (never commit it). Paths are on the server.
LAN_IP=192.168.1.10
BASE_DOMAIN=home.arpa      # if you change it, also edit the links in site/index.html
DATA_DIR=/srv/house
MEDIA_DIR=/srv/media
PUID=1000
PGID=1000
# Optional: enables Vaultwarden's /admin page. Generate a hash with:
#   docker run --rm -it vaultwarden/server:1.32.0 /vaultwarden hash
VAULTWARDEN_ADMIN_TOKEN=
